      "type": "file",
      "name": "ContributionGraph.tsx",
      "filePath": "src/components/ContributionGraph.tsx",
      "summary": "Renders the author's last-year GitHub contribution calendar in the site's lilac palette, scaling the fixed-width calendar to exactly fill its container.",
      "tags": ["component", "client-component", "github", "responsive", "theming"],
      "complexity": "moderate",
      "languageNotes": "Uses `useLayoutEffect` with a `ResizeObserver` to measure the calendar's natural width before paint, then applies a CSS transform scale so the third-party widget stretches without a gutter."
    },
