      "tags": ["component", "client-component", "animation", "hero", "accessibility"],
      "complexity": "simple",
      "languageNotes": "Uses `AnimatePresence mode=\"wait\"` keyed on the line text so the outgoing phrase finishes exiting before the next enters; `aria-live=\"polite\"` announces changes."
    },
