      "filePath": "src/components/motion/Magnetic.tsx",
      "summary": "Reusable motion primitive that makes its children drift toward the cursor while hovered and spring back on leave, used for buttons and pill links across the site.",
      "tags": ["component", "motion-primitive", "animation", "reusable", "accessibility"],
      "complexity": "simple",
      "languageNotes": "Respects `useReducedMotion` by short-circuiting the pointer handler, so the wrapper stays inert for users who prefer reduced motion."
    },
    {
      "id": "function:src/components/motion/Magnetic.tsx:Magnetic",
