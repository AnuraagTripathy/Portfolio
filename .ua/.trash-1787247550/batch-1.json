      "type": "file",
      "name": "layout.tsx",
      "filePath": "src/app/layout.tsx",
      "summary": "Next.js App Router root layout that loads the three Google fonts as CSS variables, declares site-wide SEO/OpenGraph metadata, and wraps every page in the theme provider along with the persistent nav, footer and ambient visual layers.",
      "tags": ["entry-point", "layout", "metadata", "app-router", "component"],
      "complexity": "moderate",
      "languageNotes": "Uses `next/font/google` to self-host fonts and expose them as CSS custom properties, plus `suppressHydrationWarning` on <html> because the theme class is applied on the client."
    },
    {
      "id": "function:src/app/layout.tsx:RootLayout",
