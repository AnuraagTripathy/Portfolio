      "lineRange": [16, 58],
      "summary": "Tracks pointermove events into spring-damped motion values and renders two fixed overlay divs whose radial-gradient background follows the cursor, returning null when reduced motion is preferred.",
      "tags": ["component", "animation", "event-handler", "accessibility"],
      "complexity": "moderate"
    },
