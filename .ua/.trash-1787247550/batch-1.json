      "tags": ["component", "presentational", "background", "styling"],
      "complexity": "simple"
    },
    {
      "id": "file:src/components/CursorGlow.tsx",
      "type": "file",
      "name": "CursorGlow.tsx",
      "filePath": "src/components/CursorGlow.tsx",
      "summary": "Client component that renders a soft pastel radial glow which lazily trails the pointer across the page, with separate light and dark gradients, and disables itself for reduced-motion users and non-fine pointers.",
      "tags": ["component", "animation", "event-handler", "accessibility", "effect"],
      "complexity": "moderate",
      "languageNotes": "Uses Framer Motion's `useMotionValue`/`useSpring`/`useMotionTemplate` so pointer updates drive the gradient without triggering React re-renders."
    },
    {
      "id": "function:src/components/CursorGlow.tsx:CursorGlow",
