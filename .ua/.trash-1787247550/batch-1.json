    {
      "id": "file:src/components/ThemeProvider.tsx",
      "type": "file",
      "name": "ThemeProvider.tsx",
      "filePath": "src/components/ThemeProvider.tsx",
      "summary": "Custom theme layer that owns an auto/light/dark preference persisted to localStorage, re-evaluates the clock-scheduled theme on a timer and on tab visibility changes, and feeds the resolved theme into next-themes as a forced theme.",
      "tags": ["component", "context-provider", "theme", "state-management", "hook"],
      "complexity": "moderate",
      "languageNotes": "Wraps next-themes with `forcedTheme` and `enableSystem: false`, so this provider — not the OS setting — is the single source of truth; `useLayoutEffect` reads localStorage before paint to limit theme flash."
    },
    {
      "id": "function:src/components/ThemeProvider.tsx:useThemePreference",
