{
 "nodes": [
  {
   "id": "file:src/app/layout.tsx",
   "type": "file",
   "name": "layout.tsx",
   "filePath": "src/app/layout.tsx",
   "summary": "Next.js App Router root layout that loads the three Google fonts as CSS variables, declares site-wide SEO/OpenGraph metadata, and wraps every page in the theme provider along with the persistent nav, footer and ambient visual layers."
  },
  {
   "id": "file:src/components/AmbientBackdrop.tsx",
   "type": "file",
   "name": "AmbientBackdrop.tsx",
   "filePath": "src/components/AmbientBackdrop.tsx",
   "summary": "Purely decorative fixed background layer that paints four blurred pastel blobs and a masked dot grid behind all page content, with separate opacities for light and dark mode."
  },
  {
   "id": "file:src/components/CursorGlow.tsx",
   "type": "file",
   "name": "CursorGlow.tsx",
   "filePath": "src/components/CursorGlow.tsx",
   "summary": "Client component that renders a soft pastel radial glow which lazily trails the pointer across the page, with separate light and dark gradients, and disables itself for reduced-motion users and non-fine pointers."
  },
  {
   "id": "file:src/components/Footer.tsx",
   "type": "file",
   "name": "Footer.tsx",
   "filePath": "src/components/Footer.tsx",
   "summary": "Site footer showing the current-year copyright, external links to GitHub, LinkedIn and the hosted résumé, and a playful sign-off line with an animated tilde."
  },
  {
   "id": "file:src/components/Nav.tsx",
   "type": "file",
   "name": "Nav.tsx",
   "filePath": "src/components/Nav.tsx",
   "summary": "Fixed, blurred top navigation bar with the wordmark, four route links whose active item is highlighted by a shared-layout animated pill, the theme toggle, and the scroll progress hairline."
  },
  {
   "id": "file:src/components/ScrollProgress.tsx",
   "type": "file",
   "name": "ScrollProgress.tsx",
   "filePath": "src/components/ScrollProgress.tsx",
   "summary": "Two-pixel gradient bar pinned to the bottom edge of the nav that scales horizontally with the page's scroll progress, smoothed by a spring."
  },
  {
   "id": "file:src/components/ThemeProvider.tsx",
   "type": "file",
   "name": "ThemeProvider.tsx",
   "filePath": "src/components/ThemeProvider.tsx",
   "summary": "Custom theme layer that owns an auto/light/dark preference persisted to localStorage, re-evaluates the clock-scheduled theme on a timer and on tab visibility changes, and feeds the resolved theme into next-themes as a forced theme."
  },
  {
   "id": "file:src/components/ThemeToggle.tsx",
   "type": "file",
   "name": "ThemeToggle.tsx",
   "filePath": "src/components/ThemeToggle.tsx",
   "summary": "Round sun/moon button in the nav that pins light or dark on click and returns to clock-scheduled auto mode on Alt+click, rendering a neutral placeholder until the theme preference has hydrated."
  },
  {
   "id": "file:src/lib/scheduledTheme.ts",
   "type": "file",
   "name": "scheduledTheme.ts",
   "filePath": "src/lib/scheduledTheme.ts",
   "summary": "Single-function module encoding the site's time-of-day theme schedule: light between 06:00 and 19:00 local time, dark otherwise."
  },
  {
   "id": "file:src/lib/utils.ts",
   "type": "file",
   "name": "utils.ts",
   "filePath": "src/lib/utils.ts",
   "summary": "Shared class-name helper module exposing the `cn` utility used across every component for conditional Tailwind styling."
  },
  {
   "id": "file:src/app/contact/page.tsx",
   "type": "file",
   "name": "page.tsx",
   "filePath": "src/app/contact/page.tsx",
   "summary": "Next.js App Router route for /contact, rendering a mailto card plus magnetic GitHub, LinkedIn and résumé links wrapped in scroll reveal animations."
  },
  {
   "id": "file:src/app/page.tsx",
   "type": "file",
   "name": "page.tsx",
   "filePath": "src/app/page.tsx",
   "summary": "Home page of the portfolio, composing the animated hero (rotating greeting, split headline, tilting portrait), a two-project 'Selected work' grid and the GitHub contribution graph."
  },
  {
   "id": "file:src/components/ContributionGraph.tsx",
   "type": "file",
   "name": "ContributionGraph.tsx",
   "filePath": "src/components/ContributionGraph.tsx",
   "summary": "Renders the author's last-year GitHub contribution calendar in the site's lilac palette, scaling the fixed-width calendar to exactly fill its container."
  },
  {
   "id": "file:src/components/HeroPortrait.tsx",
   "type": "file",
   "name": "HeroPortrait.tsx",
   "filePath": "src/components/HeroPortrait.tsx",
   "summary": "Hero photo card with offset pastel backing layers and a cursor-tracked radial shine highlight that springs toward the pointer on hover."
  },
  {
   "id": "file:src/components/RotatingHi.tsx",
   "type": "file",
   "name": "RotatingHi.tsx",
   "filePath": "src/components/RotatingHi.tsx",
   "summary": "Small hero greeting that cycles through four intro lines every 4.2 seconds with an animated enter/exit transition."
  },
  {
   "id": "file:src/components/motion/Magnetic.tsx",
   "type": "file",
   "name": "Magnetic.tsx",
   "filePath": "src/components/motion/Magnetic.tsx",
   "summary": "Reusable motion primitive that makes its children drift toward the cursor while hovered and spring back on leave, used for buttons and pill links across the site."
  },
  {
   "id": "file:src/components/motion/Reveal.tsx",
   "type": "file",
   "name": "Reveal.tsx",
   "filePath": "src/components/motion/Reveal.tsx",
   "summary": "Reusable scroll-reveal primitive that fades and lifts its children into place as they enter the viewport; the most widely reused animation wrapper in the site."
  },
  {
   "id": "file:src/components/motion/SplitHeadline.tsx",
   "type": "file",
   "name": "SplitHeadline.tsx",
   "filePath": "src/components/motion/SplitHeadline.tsx",
   "summary": "Headline primitive that splits text into individual characters and staggers each one rising into place, with a per-letter hover lift."
  },
  {
   "id": "file:src/app/projects/page.tsx",
   "type": "file",
   "name": "page.tsx",
   "filePath": "src/app/projects/page.tsx",
   "summary": "App Router page for the /projects route that renders every entry from the shared projects content module as a responsive two-column grid of image-led cards with tech-stack stickers and external links. Composes the Reveal, TiltCard and WavyRule motion primitives around otherwise static server-rendered markup."
  },
  {
   "id": "file:src/components/WavyRule.tsx",
   "type": "file",
   "name": "WavyRule.tsx",
   "filePath": "src/components/WavyRule.tsx",
   "summary": "Client component providing a decorative horizontal divider drawn as a soft SVG wave that animates its stroke into view on scroll. Used as a section separator across the home, contact, experience and projects pages."
  },
  {
   "id": "file:src/components/motion/TiltCard.tsx",
   "type": "file",
   "name": "TiltCard.tsx",
   "filePath": "src/components/motion/TiltCard.tsx",
   "summary": "Client-side motion wrapper that applies a subtle spring-damped 3D tilt to its children as the cursor moves across them. Used to add depth to project and experience cards."
  },
  {
   "id": "file:src/content/projects.ts",
   "type": "file",
   "name": "projects.ts",
   "filePath": "src/content/projects.ts",
   "summary": "Single source of truth for portfolio project entries, exporting a typed `Project[]` array with name, period, subtitle, description, cover image, tech stack and external links for each project. Consumed by both the projects page and the home page."
  },
  {
   "id": "file:src/app/experience/page.tsx",
   "type": "file",
   "name": "page.tsx",
   "filePath": "src/app/experience/page.tsx",
   "summary": "Next.js App Router server page for the /experience route that renders the career timeline by mapping over the typed `roles` content array into logo, title, date-range and highlight cards. Composes WavyRule, Reveal and TimelineProgress with a rotating pastel dot palette for each timeline entry."
  },
  {
   "id": "file:src/components/TimelineProgress.tsx",
   "type": "file",
   "name": "TimelineProgress.tsx",
   "filePath": "src/components/TimelineProgress.tsx",
   "summary": "Client component providing the vertical timeline rail that fills with an accent gradient as the user scrolls past the role list it sits beside. Respects the user's reduced-motion preference by omitting the animated fill entirely."
  },
  {
   "id": "file:src/content/experience.ts",
   "type": "file",
   "name": "experience.ts",
   "filePath": "src/content/experience.ts",
   "summary": "Typed content module defining the `Role` shape and exporting the `roles` array — the newest-first list of jobs with company, location, date range, summary, highlight bullets and logo path — that drives the experience timeline UI."
  },
  {
   "id": "file:next-env.d.ts",
   "type": "file",
   "name": "next-env.d.ts",
   "filePath": "next-env.d.ts",
   "summary": "Auto-generated Next.js ambient type declaration file that pulls in the `next` and `next/image-types/global` type references so TypeScript understands framework globals and image imports. Not meant to be hand-edited."
  },
  {
   "id": "file:next.config.mjs",
   "type": "file",
   "name": "next.config.mjs",
   "filePath": "next.config.mjs",
   "summary": "Next.js framework configuration that tunes the built-in image optimizer, preferring WebP over AVIF (AVIF softens JPEG portraits at default quality) and declaring a custom device-size breakpoint ladder up to 3840px."
  },
  {
   "id": "config:package.json",
   "type": "config",
   "name": "package.json",
   "filePath": "package.json",
   "summary": "Package manifest for the private `anuraag-web` portfolio, declaring the standard Next.js dev/build/start/lint scripts and pinning the runtime stack: Next 14.2, React 18, framer-motion, next-themes, lucide-react, react-github-calendar and the Tailwind class utilities (clsx, tailwind-merge)."
  },
  {
   "id": "file:postcss.config.mjs",
   "type": "file",
   "name": "postcss.config.mjs",
   "filePath": "postcss.config.mjs",
   "summary": "Minimal PostCSS configuration registering Tailwind CSS as the sole plugin, which is what expands the `@tailwind` directives and `@apply` rules in the global stylesheet during the build."
  },
  {
   "id": "file:src/app/globals.css",
   "type": "file",
   "name": "globals.css",
   "filePath": "src/app/globals.css",
   "summary": "Global stylesheet that loads the three Tailwind layers and defines the site's light/dark design tokens as raw RGB channel triples (`--tw-canvas`, `--tw-ink`, `--tw-line`, ...) on `:root` and `.dark`. Also supplies the decorative `.grain` SVG-noise and `.wash` gradient overlays, wavy-underline treatment, custom selection colors and theming for the GitHub contribution-calendar tooltips."
  },
  {
   "id": "file:src/app/template.tsx",
   "type": "file",
   "name": "template.tsx",
   "filePath": "src/app/template.tsx",
   "summary": "App Router `template.tsx` client component that wraps every routed page in a framer-motion fade-and-rise transition. Unlike a layout, a template remounts on each navigation, so the animation replays on every route change."
  },
  {
   "id": "file:tailwind.config.ts",
   "type": "file",
   "name": "tailwind.config.ts",
   "filePath": "tailwind.config.ts",
   "summary": "Tailwind design-system configuration: enables class-based dark mode, scopes content scanning to src/app, src/components and src/pages, and extends the theme with CSS-variable-backed semantic colors (canvas, surface, ink, line), a pastel and accent palette, three font families, soft/card/lift shadows, and float/wiggle keyframe animations."
  },
  {
   "id": "config:tsconfig.json",
   "type": "config",
   "name": "tsconfig.json",
   "filePath": "tsconfig.json",
   "summary": "TypeScript compiler configuration for the Next.js project: strict mode with `noEmit` (Next handles transpilation), bundler module resolution, preserved JSX, incremental builds, the `next` language-service plugin, and the `@/*` path alias mapping to `./src/*`."
  }
 ],
